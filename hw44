    int damage = A + B + C;
    if ((A % 3 == 0) && (B % 3 == 0) && (C % 3 == 0)) {
    damage = damage * 3;
        }
    healboss = healboss - damage;
    printf("Босс потерял %d здоровья, текущее здоровье босса: %d\n", damage, healboss);
    return 0;
}
